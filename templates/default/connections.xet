<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="guacamole.connections.rows" template="" lang="" group="0" version="19.1.001">
		<grid width="100%">
			<columns>
				<column width="15"/>
				<column width="15%"/>
				<column width="120"/>
				<column width="15%"/>
			</columns>
			<rows>
				<row class="th">
					<nextmatch-sortheader label="#" id="connection_id"/>
					<et2-nextmatch-header  label="Name" id="connection_name"></et2-nextmatch-header>
					<et2-nextmatch-header  id="protocol" emptyLabel="Protocol"></et2-nextmatch-header>
					<nextmatch-sortheader label="Hostname" id="#hostname"/>
				</row>
				<row class="$row_cont[cat_id] $row_cont[class]">
					<et2-description  id="${row}[connection_id]"></et2-description>
					<et2-description  id="${row}[connection_name]"></et2-description>
					<et2-select  id="${row}[protocol]" readonly="true"></et2-select>
					<et2-description  id="${row}[#hostname]"></et2-description>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="guacamole.connections.add" template="" lang="" group="0" version="19.1.001">
		<et2-button  label="Add" id="add" onclick="egw(window).openPopup(egw::link('/index.php','menuaction=guacamole.EGroupware\\Guacamole\\Ui.edit'),'640','480','_blank','admin'); return false;" noSubmit="true"></et2-button>
	</et2-template>
	<et2-template  id="guacamole.connections" template="" lang="" group="0" version="19.1.001">
		<nextmatch id="nm" options="guacamole.connections.rows" header_left="guacamole.connections.add"/>
	</et2-template>
</overlay>
